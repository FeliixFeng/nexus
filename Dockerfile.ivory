FROM python:3.11-slim
WORKDIR /app
ENV PIP_ROOT_USER_ACTION=ignore
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
    "django>=5.2.14" "bleach>=6.3.0" "django-htmx>=1.27.0" "gunicorn>=23.0.0" \
    "markdown>=3.10.2" "pillow>=12.2.0" "pygments>=2.20.0" "python-dotenv>=1.0.0" \
    "python-mpd2>=3.0.0" "requests>=2.31.0" "whitenoise>=6.5.0"
COPY . .
EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2"]
